{
  "redirects": [
    {
      "source": "/industry-leading-affiliates/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/login/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/password-reset/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-policy/index.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-conditions/:path*",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/offerings/:path*",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog.html",
      "destination": "/blog.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
